# ── Sitio ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.tudiligencialegal.com
NEXT_PUBLIC_WHATSAPP_DISPLAY=+58 412 000 0000
NEXT_PUBLIC_CONTACT_EMAIL=info@tudiligencialegal.com
NEXT_PUBLIC_WHATSAPP_NUMBER=584120000000   # solo dígitos, para enlaces wa.me
SESSION_SECRET=            # 32+ caracteres aleatorios (openssl rand -base64 32)

# ── HubSpot (CRM) ─────────────────────────────────────
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_PIPELINE_ID=default
HUBSPOT_STAGE_NUEVO=               # ID de la etapa "Nuevo lead"
HUBSPOT_STAGE_PREEVALUADO=         # ID de "Pre-evaluado"
HUBSPOT_STAGE_PAGO_PENDIENTE=      # ID de "Pago pendiente"
HUBSPOT_STAGE_CONSULTA_PAGADA=     # ID de "Consulta pagada"
# IDs de etapa, en orden, para las 6 fases del portal Mi caso:
# Consulta, Propuesta y pago, Búsqueda de documentos, Expediente, Presentación, Resolución
HUBSPOT_STAGE_ORDER=

# ── Stripe (pagos con tarjeta) ────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Pagos manuales ────────────────────────────────────
ZELLE_EMAIL=
ZELLE_NAME=
BINANCE_PAY_ID=            # ID para pago manual (si no hay API)
# Binance Pay Merchant API (pago automático). Webhook: https://TU-DOMINIO/api/binance/webhook
BINANCE_PAY_API_KEY=
BINANCE_PAY_SECRET=

# ── Cal.com (agenda de abogados) ──────────────────────
CALCOM_API_KEY=
# Un ID de tipo de evento por consulta (fallback para todas las áreas):
CALCOM_EVENT_DEFAULT_INICIAL=
CALCOM_EVENT_DEFAULT_ESTRATEGIA=
CALCOM_EVENT_DEFAULT_URGENTE=
# Opcional, por área (ES, IT, PT, OTRAS, VISAS, NEGOCIOS, CARIBE), p. ej.:
# CALCOM_EVENT_ES_INICIAL=
# CALCOM_EVENT_IT_INICIAL=

# ── WhatsApp Cloud API (Meta) ─────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=     # texto que eliges y repites en Meta al configurar el webhook
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_LANG=es

# ── Diana (Claude) ────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ── Correo (Resend) ───────────────────────────────────
# Correo: usa SMTP (p. ej. el buzón info@ de tu hosting) O Resend. Con SMTP_HOST definido se usa SMTP.
SMTP_HOST=                 # p. ej. mail.tudiligencialegal.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=                 # info@tudiligencialegal.com
SMTP_PASS=
RESEND_API_KEY=
EMAIL_FROM=Tu Diligencia Legal <info@tudiligencialegal.com>
TEAM_NOTIFICATION_EMAIL=info@tudiligencialegal.com   # recibe copia de TODOS los formularios y pagos

# Base de datos (Neon Postgres, desde Vercel > Storage). Guarda todas las solicitudes y pagos.
DATABASE_URL=
# Panel interno /admin
ADMIN_PASSWORD=            # 16+ caracteres

# ── Archivos del portal (Vercel Blob) ─────────────────
BLOB_READ_WRITE_TOKEN=

# ── SEO y entidad ─────────────────────────────────────
NEXT_PUBLIC_LEGAL_NAME=            # razón social
NEXT_PUBLIC_LEGAL_TAX_ID=          # NIF/CIF
NEXT_PUBLIC_LEGAL_ADDRESS=         # domicilio social
NEXT_PUBLIC_LEGAL_REGISTRY=        # inscripción en el Registro Mercantil
NEXT_PUBLIC_LEGAL_BAR=             # Colegio de la Abogacía y n.º de colegiación
NEXT_PUBLIC_PRIVACY_EMAIL=info@tudiligencialegal.com
NEXT_PUBLIC_LEGAL_DPO=             # Delegado de Protección de Datos, si existe
NEXT_PUBLIC_SAME_AS=               # URLs de perfiles oficiales separadas por coma (Google Business, LinkedIn, Instagram…)
NEXT_PUBLIC_CERTIA_URL=https://certia.group
NEXT_PUBLIC_DEFAULT_AUTHOR=        # autor por defecto de artículos (abogado/a con nombre)
NEXT_PUBLIC_GSC_VERIFICATION=      # código de Google Search Console (meta tag)
NEXT_PUBLIC_BING_VERIFICATION=     # código de Bing Webmaster Tools

# ── Analítica y publicidad (con Consent Mode v2) ──────
NEXT_PUBLIC_GA_ID=                 # G-XXXXXXX (GA4)
NEXT_PUBLIC_GADS_ID=               # AW-XXXXXXX (Google Ads)
NEXT_PUBLIC_GADS_LABEL_LEAD_A=     # etiqueta de conversión "Lead cualificado (A)"
NEXT_PUBLIC_GADS_LABEL_LEAD=       # etiqueta de conversión "Lead"
NEXT_PUBLIC_GADS_LABEL_PURCHASE=   # etiqueta de conversión "Consulta pagada"
NEXT_PUBLIC_META_PIXEL_ID=

# Redes sociales (aparecen en todos los correos automáticos)
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_X=
